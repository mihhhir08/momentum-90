# All optional. Missing keys degrade gracefully to a local-only terminal.

# Cloud sync + sign-in. Without these, everything lives in localStorage.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key

# Server-only. Needed to create read-only share links.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Alfred's daily remark. Without a key he simply stays silent.
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL=anthropic/claude-3.5-haiku

# Nightly floor nudge. Resend's test sender only delivers to your own address,
# which is exactly the use case here, so no domain is required.
RESEND_API_KEY=re_...
NUDGE_EMAIL=you@example.com
NUDGE_FROM=BATCOMPUTER <onboarding@resend.dev>

# Set this to any long random string. The cron route refuses callers without it.
CRON_SECRET=generate-a-long-random-string
